# Local development (docker compose up -d)
DATABASE_URL=postgres://postgres:postgres@localhost:5433/clip_campaigns

# Used by the test suite only — a separate database on the same instance,
# created automatically by docker/init/01-create-test-db.sql
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5433/clip_campaigns_test

# HMAC key for the signed session cookie. Any random string works locally.
SESSION_SECRET=dev-only-secret-change-me
